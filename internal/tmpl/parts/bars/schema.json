{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bars",
  "description": "Values side by side as bars, each a label and a value, the largest the longest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "minLength": 1 },
      "value": { "type": "number", "minimum": 0 },
      "tone": { "$ref": "floe:///parts/tone.json", "description": "The bar's colour, accent when left out" }
    },
    "required": ["label", "value"],
    "additionalProperties": false
  }
}
