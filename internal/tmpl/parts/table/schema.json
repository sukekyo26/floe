{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "table",
  "description": "A table; each cell is a line of Markdown (code, bold, links), a number in quotes as it is drawn, or a pill",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "A line of Markdown" },
          "num": { "type": "boolean", "description": "Numbers: aligned right, in a fixed-width font" }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "description": "Rows of cells, as many as the columns: a line of Markdown, or a pill { pill: a short status, as it is, tone }; quote a cell holding ': '",
      "items": {
        "type": "array",
        "items": {
          "type": ["string", "object"],
          "properties": {
            "pill": { "type": "string", "minLength": 1 },
            "tone": { "$ref": "floe:///parts/tone.json" }
          },
          "required": ["pill"],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "minItems": 1
    }
  },
  "required": ["columns", "rows"],
  "additionalProperties": false
}
