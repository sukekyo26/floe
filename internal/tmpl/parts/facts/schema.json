{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "facts",
  "description": "Names with their values, as owner, due and state at the top of a page, in tiles side by side",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "value": { "$ref": "floe:///parts/cell.json" }
    },
    "required": ["name", "value"],
    "additionalProperties": false
  }
}
