{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix",
  "description": "What holds where: a table of rows by columns, each cell yes (✓), part (△) or no (×), with a few words under it if written { mark, note }",
  "type": "object",
  "properties": {
    "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "description": "A line of Markdown" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "what": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
          "cells": {
            "type": "array",
            "description": "As many as the columns: yes, part or no, or { mark, note }",
            "items": {
              "type": ["string", "object"],
              "properties": {
                "mark": { "enum": ["yes", "part", "no"] },
                "note": { "type": "string", "minLength": 1 }
              },
              "required": ["mark"],
              "additionalProperties": false
            }
          }
        },
        "required": ["what", "cells"],
        "additionalProperties": false
      }
    }
  },
  "required": ["columns", "rows"],
  "additionalProperties": false
}
