{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checklist",
  "description": "Items to check, each ticked once done, with the count of those done at the end",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
      "done": { "type": "boolean" }
    },
    "required": ["text"],
    "additionalProperties": false
  }
}
