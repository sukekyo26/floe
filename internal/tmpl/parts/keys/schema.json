{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keys",
  "description": "Keys to press, each the keys pressed together, drawn as keycaps, and what they do",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "keys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Pressed together, such as [Ctrl, K]" },
      "text": { "type": "string", "minLength": 1, "description": "What they do; a line of Markdown" }
    },
    "required": ["keys", "text"],
    "additionalProperties": false
  }
}
