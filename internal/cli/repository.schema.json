{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "documents"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "documents": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
