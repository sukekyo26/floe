$ floe check en.yaml fr.yaml ja-JP.yaml ja.yaml
exit 0
$ floe render --out-dir $TMP/pages/en.yaml en.yaml
exit 0
--- stdout
$TMP/pages/en.yaml/en.html
$ floe render --out-dir $TMP/pages/fr.yaml fr.yaml
exit 0
--- stdout
$TMP/pages/fr.yaml/fr.html
$ floe render --out-dir $TMP/pages/ja-JP.yaml ja-JP.yaml
exit 0
--- stdout
$TMP/pages/ja-JP.yaml/ja-JP.html
$ floe render --out-dir $TMP/pages/ja.yaml ja.yaml
exit 0
--- stdout
$TMP/pages/ja.yaml/ja.html
$ floe render --out-dir $TMP/together en.yaml fr.yaml ja-JP.yaml ja.yaml
exit 0
--- stdout
$TMP/together/en.html
$TMP/together/fr.html
$TMP/together/ja-JP.html
$TMP/together/ja.html
