$ floe check en.yaml fr.yaml ja-JP.yaml ja.yaml
exit 0
$ floe render --out-dir $TMP/out en.yaml
exit 0
--- stdout
$TMP/out/en.html
$ floe render --out-dir $TMP/out fr.yaml
exit 0
--- stdout
$TMP/out/fr.html
$ floe render --out-dir $TMP/out ja-JP.yaml
exit 0
--- stdout
$TMP/out/ja-JP.html
$ floe render --out-dir $TMP/out ja.yaml
exit 0
--- stdout
$TMP/out/ja.html
