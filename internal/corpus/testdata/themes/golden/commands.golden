$ floe check blueprint.yaml brutal.yaml default.yaml editorial.yaml ink.yaml notebook.yaml soft.yaml swiss.yaml washi.yaml
exit 0
$ floe render --out-dir $TMP/out blueprint.yaml
exit 0
--- stdout
$TMP/out/blueprint.html
$ floe render --out-dir $TMP/out brutal.yaml
exit 0
--- stdout
$TMP/out/brutal.html
$ floe render --out-dir $TMP/out default.yaml
exit 0
--- stdout
$TMP/out/default.html
$ floe render --out-dir $TMP/out editorial.yaml
exit 0
--- stdout
$TMP/out/editorial.html
$ floe render --out-dir $TMP/out ink.yaml
exit 0
--- stdout
$TMP/out/ink.html
$ floe render --out-dir $TMP/out notebook.yaml
exit 0
--- stdout
$TMP/out/notebook.html
$ floe render --out-dir $TMP/out soft.yaml
exit 0
--- stdout
$TMP/out/soft.html
$ floe render --out-dir $TMP/out swiss.yaml
exit 0
--- stdout
$TMP/out/swiss.html
$ floe render --out-dir $TMP/out washi.yaml
exit 0
--- stdout
$TMP/out/washi.html
$ floe render --out-dir $TMP/together blueprint.yaml brutal.yaml default.yaml editorial.yaml ink.yaml notebook.yaml soft.yaml swiss.yaml washi.yaml
exit 0
--- stdout
$TMP/together/blueprint.html
$TMP/together/brutal.html
$TMP/together/default.html
$TMP/together/editorial.html
$TMP/together/ink.html
$TMP/together/notebook.html
