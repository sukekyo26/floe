{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cell",
  "description": "A line of Markdown, or a pill { pill: a short status, as it is, tone }; quote one holding ': '",
  "type": ["string", "object"],
  "properties": {
    "pill": { "type": "string", "minLength": 1 },
    "tone": { "$ref": "floe:///parts/tone.json" }
  },
  "required": ["pill"],
  "additionalProperties": false
}
