{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagram",
  "description": "A diagram: a canvas of width by height (either left out, as far as what is drawn reaches and 20 more) and the parts placed on it, a graph of boxes and edges that floe lays out among them, drawn as inline SVG; or example, the name of a built-in one, which floe diagram example lists",
  "type": "object",
  "if": { "required": ["example"] },
  "then": {
    "additionalProperties": false,
    "properties": {
      "example": { "type": "string", "minLength": 1, "description": "A kind of diagram floe diagram example lists, drawn in the page's language" }
    }
  },
  "else": {
    "required": ["title", "parts"],
    "additionalProperties": false,
    "properties": {
      "width": { "$ref": "#/$defs/size", "description": "Left out, as far right as what is drawn reaches and 20 more; raw SVG is not measured, so write it with raw" },
      "height": { "$ref": "#/$defs/size", "description": "Left out, as far down as what is drawn reaches and 20 more; raw SVG is not measured, so write it with raw" },
      "title": { "$ref": "#/$defs/text", "description": "What the diagram shows, for a reader who cannot see it" },
      "parts": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "One key naming the kind of the part",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "frame": { "$ref": "#/$defs/frame" },
            "box": { "$ref": "#/$defs/box" },
            "table": { "$ref": "#/$defs/table" },
            "icon": { "$ref": "#/$defs/icon" },
            "edge": { "$ref": "#/$defs/edge" },
            "dot": { "$ref": "#/$defs/dot" },
            "bar": { "$ref": "#/$defs/bar" },
            "axis": { "$ref": "#/$defs/axis" },
            "circle": { "$ref": "#/$defs/circle" },
            "label": { "$ref": "#/$defs/label" },
            "line": { "$ref": "#/$defs/line" },
            "raw": { "$ref": "#/$defs/raw" },
            "tree": { "$ref": "#/$defs/tree" },
            "graph": { "$ref": "#/$defs/graph" }
          }
        }
      }
    }
  },
  "$defs": {
    "size": { "type": "number", "minimum": 1 },
    "text": {
      "description": "Text, or its words in each language by tag, English among them: {en: …, ja: …}",
      "type": ["string", "object"],
      "required": ["en"],
      "additionalProperties": { "type": "string" }
    },
    "name": { "type": "string", "minLength": 1, "description": "The name an edge's from or to gives, unique in the diagram" },
    "tone": { "$ref": "floe:///parts/tone.json" },
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "side": { "enum": ["top", "right", "bottom", "left"] },
    "origin": { "enum": ["left", "centre"], "description": "What x is: the left edge (the default) or the centre" },
    "end": {
      "description": "The name of a part, a named row or a node, or a point [x, y]",
      "type": ["string", "array"],
      "minLength": 1,
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "marker": { "enum": ["none", "arrow", "triangle", "diamond", "odiamond", "one", "many", "zero-one", "zero-many"] },
    "frame": {
      "type": "object",
      "description": "A box around other parts, its label inside the top left corner, or right of its icon. Frames are not checked against one another, so they may cross, and a frame's label is held to the frame's width, not its height or a canvas written",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "x": { "type": "number" }, "y": { "type": "number" }, "w": { "$ref": "#/$defs/size" }, "h": { "$ref": "#/$defs/size" },
        "label": { "$ref": "#/$defs/text" },
        "accent": { "type": "boolean" },
        "icon": { "type": "string", "description": "An icon in the corner, the AWS group frame style" },
        "square": { "type": "boolean" }
      }
    },
    "box": {
      "type": "object",
      "description": "A box of centred rows of text, as wide and tall as they need when w and h are left out",
      "required": ["x", "y", "rows"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "x": { "type": "number" }, "y": { "type": "number" }, "origin": { "$ref": "#/$defs/origin" },
        "w": { "$ref": "#/$defs/size" }, "h": { "$ref": "#/$defs/size" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "description": "Each a text, or [text, style]; without a style the first is main and the rest sub",
          "items": {
            "type": ["string", "object", "array"],
            "required": ["en"],
            "additionalProperties": { "type": "string" },
            "prefixItems": [{ "$ref": "#/$defs/text" }, { "enum": ["main", "sub", "main code", "sub code"] }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "tone": { "$ref": "#/$defs/tone" },
        "shape": { "enum": ["rect", "pill", "hex", "state"] }
      }
    },
    "table": {
      "type": "object",
      "description": "A heading over rows of a name and a type (an ER entity, a class)",
      "required": ["x", "y", "title", "rows"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "x": { "type": "number" }, "y": { "type": "number" }, "origin": { "$ref": "#/$defs/origin" },
        "w": { "$ref": "#/$defs/size" },
        "title": { "$ref": "#/$defs/text" },
        "rows": {
          "type": "array",
          "description": "Each [name, type] or [name], --- for a separator, or {name, cells: [name, type]} for a row an edge can end at",
          "items": {
            "type": ["string", "array", "object"],
            "minItems": 1,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/text" },
            "required": ["name", "cells"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "cells": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "icon": {
      "type": "object",
      "description": "An icon of an icon set (aws/…, found with floe icons search) with its top left at x, y",
      "required": ["icon", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "icon": { "type": "string" },
        "x": { "type": "number" }, "y": { "type": "number" },
        "label": { "$ref": "#/$defs/text" },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "edge": {
      "type": "object",
      "description": "A line from one end to another: right-angled through via, or straight from point to point with straight",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/end" }, "to": { "$ref": "#/$defs/end" },
        "fromSide": { "$ref": "#/$defs/side" }, "toSide": { "$ref": "#/$defs/side" },
        "via": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "straight": { "type": "boolean" },
        "label": { "$ref": "#/$defs/text" },
        "at": { "$ref": "#/$defs/point" },
        "dashed": { "type": "boolean" }, "bold": { "type": "boolean" },
        "tone": { "$ref": "#/$defs/tone" },
        "start": { "$ref": "#/$defs/marker" }, "end": { "$ref": "#/$defs/marker" },
        "crossing": { "type": "boolean", "description": "Lets this edge cross another" }
      }
    },
    "dot": {
      "type": "object",
      "description": "A circle edges may reach the centre of (a commit, a milestone, a start state)",
      "required": ["cx", "cy"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "cx": { "type": "number" }, "cy": { "type": "number" }, "r": { "$ref": "#/$defs/size" },
        "tone": { "$ref": "#/$defs/tone" }, "hollow": { "type": "boolean" }
      }
    },
    "bar": {
      "type": "object",
      "description": "A horizontal span (a timeline period), its label to the right",
      "required": ["x1", "x2", "y"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "x1": { "type": "number" }, "x2": { "type": "number" }, "y": { "type": "number" },
        "tone": { "$ref": "#/$defs/tone" }, "label": { "$ref": "#/$defs/text" }
      }
    },
    "axis": {
      "type": "object",
      "description": "A time axis with labelled ticks, and grid lines up to grid",
      "required": ["x1", "x2", "y", "ticks"],
      "additionalProperties": false,
      "properties": {
        "x1": { "type": "number" }, "x2": { "type": "number" }, "y": { "type": "number" },
        "ticks": {
          "type": "array",
          "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "$ref": "#/$defs/text" }], "minItems": 2, "maxItems": 2 }
        },
        "grid": { "type": "number" }
      }
    },
    "circle": {
      "type": "object",
      "description": "A translucent circle that may overlap others (a Venn diagram)",
      "required": ["cx", "cy", "r"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "cx": { "type": "number" }, "cy": { "type": "number" }, "r": { "$ref": "#/$defs/size" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "label": {
      "type": "object",
      "description": "Text at x, y, or in the area of a Venn diagram inside the circles of in and outside the others",
      "required": ["text"],
      "additionalProperties": false,
      "if": { "required": ["in"] },
      "then": { "dependentRequired": { "x": ["y"], "y": ["x"], "anchor": ["x"] } },
      "else": { "required": ["x", "y"] },
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "x": { "type": "number" }, "y": { "type": "number" },
        "anchor": { "enum": ["middle", "start", "end"], "description": "Only where x and y place the label; with in alone, leave it out" },
        "plain": { "type": "boolean", "description": "No background, for text on a coloured area" },
        "strong": { "type": "boolean" },
        "in": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } }
      }
    },
    "line": {
      "type": "object",
      "description": "A line without arrows: a line, a lifeline or a divider",
      "required": ["x1", "y1", "x2", "y2"],
      "additionalProperties": false,
      "properties": {
        "x1": { "type": "number" }, "y1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" },
        "kind": { "enum": ["line", "lifeline", "divider"] }
      }
    },
    "tree": {
      "type": "object",
      "description": "A tree of boxes, its root's centre at x and top at y: floe places each node under its parent and draws the edges",
      "required": ["x", "y", "root"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "root": { "$ref": "#/$defs/node" } }
    },
    "node": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "rows": { "$ref": "#/$defs/box/properties/rows" },
        "tone": { "$ref": "#/$defs/tone" },
        "shape": { "$ref": "#/$defs/box/properties/shape" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "graph": {
      "type": "object",
      "description": "Boxes and the edges between them, which floe lays out in ranks, the top left of all of it at x and y; the edges of one graph may cross one another",
      "required": ["x", "y", "nodes"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "direction": { "enum": ["down", "right"], "description": "Which way the edges run: down (the default) or right" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "description": "One key naming the kind of the node",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": { "box": { "$ref": "#/$defs/graphBox" } }
          }
        },
        "edges": { "type": "array", "maxItems": 400, "items": { "$ref": "#/$defs/graphEdge" } }
      }
    },
    "graphBox": {
      "type": "object",
      "description": "A box of the graph, as wide and tall as its rows need, or wider for the edges at a side",
      "required": ["name", "rows"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "rows": { "$ref": "#/$defs/box/properties/rows" },
        "tone": { "$ref": "#/$defs/tone" },
        "shape": { "$ref": "#/$defs/box/properties/shape" }
      }
    },
    "graphEdge": {
      "type": "object",
      "description": "An edge from a box of the graph to a box of the graph, by name",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/text", "description": "Words on the edge, which make every edge of its graph two ranks long" },
        "dashed": { "type": "boolean" },
        "bold": { "type": "boolean" },
        "tone": { "$ref": "#/$defs/tone" },
        "start": { "$ref": "#/$defs/graphMarker" },
        "end": { "$ref": "#/$defs/graphMarker" }
      }
    },
    "graphMarker": { "enum": ["none", "arrow"], "description": "An arrowhead or none: the others are wider than the room the edges of a graph keep between them" },
    "raw": {
      "type": "object",
      "description": "SVG no part draws, of SVG's elements alone, without script or foreignObject (which a page takes elsewhere) or an element a page refuses, left out of the checks",
      "required": ["svg"],
      "additionalProperties": false,
      "properties": { "svg": { "type": "string" } }
    }
  }
}
