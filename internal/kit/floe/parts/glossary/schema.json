{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glossary",
  "description": "Words and what they mean, one to a row",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "term": { "type": "string", "minLength": 1 },
      "text": { "type": "string", "minLength": 1, "description": "What it means; Markdown" }
    },
    "required": ["term", "text"],
    "additionalProperties": false
  }
}
