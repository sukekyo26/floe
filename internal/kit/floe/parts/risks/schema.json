{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risks",
  "description": "Risks in a table, each how likely and how heavy (low, mid or high), coloured by both, and what is done about it",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "what": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
      "likely": { "enum": ["low", "mid", "high"] },
      "impact": { "enum": ["low", "mid", "high"] },
      "fix": { "type": "string", "minLength": 1, "description": "What is done about it; a line of Markdown" }
    },
    "required": ["what", "likely", "impact"],
    "additionalProperties": false
  }
}
