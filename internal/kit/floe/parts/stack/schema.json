{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack",
  "description": "Parts one under another, as details, tabs, columns and an item of entries, checks or options hold them",
  "$comment": "Never tabs: tabs draws a form, and the parser drops a form inside a form, joining the radios of both tabs into one group. Never columns: a column would hold columns. Never html: its </form>, at any depth in tabs (in details in tabs too), closes tabs' form, and the tabs after it stand outside it",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "description": "One key naming the kind of the part",
    "properties": {
      "text": { "$ref": "floe:///parts/text.json", "minLength": 1 },
      "code": { "$ref": "floe:///parts/code.json" },
      "terminal": { "$ref": "floe:///parts/terminal.json" },
      "table": { "$ref": "floe:///parts/table.json" },
      "image": { "$ref": "floe:///parts/image.json" },
      "note": { "$ref": "floe:///parts/note.json" },
      "stats": { "$ref": "floe:///parts/stats.json" },
      "steps": { "$ref": "floe:///parts/steps.json" },
      "checklist": { "$ref": "floe:///parts/checklist.json" },
      "options": { "$ref": "floe:///parts/options.json" },
      "facts": { "$ref": "floe:///parts/facts.json" },
      "diff": { "$ref": "floe:///parts/diff.json" },
      "tree": { "$ref": "floe:///parts/tree.json" },
      "links": { "$ref": "floe:///parts/links.json" },
      "details": { "$ref": "floe:///parts/details.json" },
      "decision": { "$ref": "floe:///parts/decision.json" },
      "fields": { "$ref": "floe:///parts/fields.json" },
      "timeline": { "$ref": "floe:///parts/timeline.json" },
      "bars": { "$ref": "floe:///parts/bars.json" },
      "chart": { "$ref": "floe:///parts/chart.json" },
      "entries": { "$ref": "floe:///parts/entries.json" },
      "keys": { "$ref": "floe:///parts/keys.json" },
      "asks": { "$ref": "floe:///parts/asks.json" },
      "checks": { "$ref": "floe:///parts/checks.json" },
      "script": { "$ref": "floe:///parts/script.json" },
      "diagram": { "$ref": "floe:///parts/diagram.json" }
    },
    "minProperties": 1,
    "maxProperties": 1,
    "additionalProperties": false
  }
}
