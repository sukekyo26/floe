{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack",
  "description": "Parts one under another, as details and tabs hold them",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "description": "One key naming the kind of the part",
    "properties": {
      "text": { "$ref": "floe:///parts/text.json", "minLength": 1 },
      "code": { "$ref": "floe:///parts/code.json" },
      "terminal": { "$ref": "floe:///parts/terminal.json" },
      "diff": { "$ref": "floe:///parts/diff.json" },
      "note": { "$ref": "floe:///parts/note.json" },
      "table": { "$ref": "floe:///parts/table.json" },
      "image": { "$ref": "floe:///parts/image.json" }
    },
    "minProperties": 1,
    "maxProperties": 1,
    "additionalProperties": false
  }
}
