{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faq",
  "description": "Questions, each opening its answer when clicked",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "q": { "type": "string", "minLength": 1, "description": "The question" },
      "a": { "type": "string", "minLength": 1, "description": "The answer; Markdown, for a link, code or a list" },
      "open": { "type": "boolean", "description": "Open when the page opens" }
    },
    "required": ["q", "a"],
    "additionalProperties": false
  }
}
