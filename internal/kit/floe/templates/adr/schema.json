{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adr",
  "description": "A decision record, one decision on a sheet: its status, the context, the decision, the options set aside and why, and the consequences, good and bad; a record superseded names the one that superseded it.",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "minLength": 1,
      "description": "The record's number, such as ADR 0007"
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "description": "When it was decided"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ],
      "description": "Stamped under the title; superseded needs superseded_by"
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1,
      "description": "The record that superseded this one, such as [ADR 0012](/a/adr-0012/), written only when the status is superseded; a line of Markdown"
    },
    "deciders": {
      "type": "string",
      "minLength": 1,
      "description": "Who decided"
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "format": "markdown",
      "description": "Why a decision was needed"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "format": "markdown",
      "description": "What was decided, and why"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "description": "The options set aside",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "A line of Markdown"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Why it was set aside; a line of Markdown"
          }
        },
        "required": [
          "title",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "consequences": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "good": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "What it gains; a line of Markdown"
          }
        },
        "bad": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "What it costs; a line of Markdown"
          }
        }
      },
      "additionalProperties": false
    },
    "more": {
      "type": "array",
      "minItems": 1,
      "description": "Sections of your own after the rest, each a heading over parts",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "floe:///parts/any.json"
            }
          }
        },
        "required": [
          "heading"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "context",
    "decision"
  ],
  "if": {
    "properties": {
      "status": {
        "const": "superseded"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "superseded_by"
    ]
  },
  "additionalProperties": false
}
