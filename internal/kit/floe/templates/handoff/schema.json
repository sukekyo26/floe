{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff",
  "description": "A handoff of work or a status update, what to decide first: the date, who hands to whom, decisions asked for, what is done, in progress and next, what to watch out for, and sections of your own.",
  "type": "object",
  "properties": {
    "date": { "type": "string", "minLength": 1, "description": "When the state is of, such as 2030-05-14 18:00" },
    "from": { "type": "string", "minLength": 1, "description": "Who hands the work over" },
    "to": { "type": "string", "minLength": 1, "description": "Who takes it" },
    "summary": { "type": "string", "minLength": 1, "description": "A sentence or two under the title; a line of Markdown" },
    "asks": {
      "type": "array", "minItems": 1,
      "description": "What the reader is asked to decide, first on the page",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1, "description": "A line of Markdown" } },
          "recommend": { "type": "string", "minLength": 1, "description": "The option recommended, on a line of its own; a line of Markdown" },
          "why": { "type": "string", "minLength": 1, "description": "Why it is recommended; a line of Markdown" },
          "by": { "type": "string", "minLength": 1, "description": "Who is to decide" }
        },
        "required": ["question"],
        "additionalProperties": false
      }
    },
    "done": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "what": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
          "ref": { "type": "string", "minLength": 1, "description": "A pull request, a ticket or the like" }
        },
        "required": ["what"],
        "additionalProperties": false
      }
    },
    "doing": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "who": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1, "description": "A line of Markdown" },
          "where": { "type": "string", "minLength": 1, "description": "How far it has gone; a line of Markdown" },
          "state": { "enum": ["doing", "waiting", "blocked"], "description": "Working, waiting on an answer, or blocked; left out, no badge" }
        },
        "required": ["who", "what"],
        "additionalProperties": false
      }
    },
    "next": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "description": "A line of Markdown" } },
    "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "description": "What the reader should watch out for; a line of Markdown" } },
    "more": {
      "type": "array", "minItems": 1,
      "description": "Sections of your own after the rest, each a heading over parts, as report's",
      "items": {
        "type": "object",
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "parts": { "type": "array", "items": { "$ref": "floe:///parts/any.json" } }
        },
        "required": ["heading"],
        "additionalProperties": false
      }
    }
  },
  "required": ["date"],
  "additionalProperties": false
}
